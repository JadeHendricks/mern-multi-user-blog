{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // ES2020 output so the CRA client (webpack 4) and a later Vite build can both parse it.
    "target": "ES2020",
    "lib": ["ES2020"],
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "types": []
  },
  "include": ["src"]
}
