{
  // Application code. Tests and test helpers live in tsconfig.test.json so the vitest globals
  // (describe, it, vi) are not visible to app code.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "noEmit": true,
    // Temporary: lets converted and not yet converted files import each other. Removed with the last conversion.
    "allowJs": true,
    "checkJs": false,
    "types": ["vite/client"],
    "tsBuildInfoFile": "../node_modules/.tmp/client-app.tsbuildinfo"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.*", "src/testing", "src/setupTests.*"],
  "references": [{ "path": "../shared" }]
}
