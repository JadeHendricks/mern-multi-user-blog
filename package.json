{
  "name": "mern-starterkit",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server",
    "server": "nodemon server",
    "start:client": "npm start --prefix client",
    "clientinstall": "npm install --prefix client",
    "start:dev": "concurrently \"npm run server\" \" npm run start:client\"",
    "test:api": "vitest run --config vitest.config.mjs",
    "e2e:install": "playwright install chromium",
    "serve:memory": "node e2e/support/start-api.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JadeHendricks/mern-starterkit.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JadeHendricks/mern-starterkit/issues"
  },
  "homepage": "https://github.com/JadeHendricks/mern-starterkit#readme",
  "dependencies": {
    "@sendgrid/mail": "7.2.1",
    "bcryptjs": "2.4.3",
    "config": "3.3.1",
    "cookie-parser": "1.4.5",
    "cors": "2.8.5",
    "express": "4.17.1",
    "express-mongo-sanitize": "2.0.0",
    "express-rate-limit": "5.1.3",
    "express-validator": "6.6.0",
    "helmet": "3.23.3",
    "hpp": "0.2.3",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.15",
    "mongoose": "5.9.18",
    "morgan": "1.10.0",
    "multer": "1.4.1",
    "xss-clean": "0.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "concurrently": "5.2.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "mongodb-memory-server": "11.3.0",
    "nodemon": "2.0.4",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  }
}
