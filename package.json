{
  "name": "mern-multi-user-blog",
  "version": "1.0.0",
  "private": true,
  "description": "",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "server",
    "client",
    "shared"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "predev": "npm run setup",
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "build:shared": "npm run build -w shared",
    "dev:api": "npm run build:shared && npm run dev -w server",
    "dev:web": "npm start -w client",
    "build": "npm run build -w client",
    "start": "npm run build:shared && npm start -w server",
    "test": "npm run test:api && npm run test:client",
    "pretest:api": "npm run build:shared",
    "test:api": "npm run test -w shared && npm run test:api -w server",
    "pretest:api:mongo": "npm run build:shared",
    "test:api:mongo": "npm run test:api:mongo -w server",
    "test:client": "cross-env SKIP_PREFLIGHT_CHECK=true npm test -w client -- --watchAll=false --passWithNoTests",
    "pretest:e2e": "npm run build:shared",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots",
    "e2e:install": "playwright install chromium",
    "serve:memory": "npm run build:shared && node --import tsx e2e/support/start-api.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run test:api && npm run test:api:mongo && npm run test:client && npm run test:e2e",
    "seed": "npm run build:shared && npm run seed -w server --",
    "db:export": "npm run build:shared && npm run db:export -w server --",
    "db:import": "npm run build:shared && npm run db:import -w server --"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JadeHendricks/mern-starterkit.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/JadeHendricks/mern-starterkit/issues"
  },
  "homepage": "https://github.com/JadeHendricks/mern-starterkit#readme",
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "concurrently": "10.0.6",
    "cross-env": "10.1.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2"
  }
}
