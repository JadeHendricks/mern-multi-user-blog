{
  "name": "@mern-blog/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API for the MERN multi-user blog",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -b tsconfig.build.json && node build-assets.mjs",
    "start": "node --env-file-if-exists=../.env --enable-source-maps dist/src/server.js",
    "typecheck": "tsc -b tsconfig.json",
    "test:api": "vitest run --config vitest.config.ts",
    "test:api:mongo": "cross-env TEST_DB_DRIVER=mongo vitest run --config vitest.config.ts test/api",
    "seed": "tsx --env-file-if-exists=../.env scripts/seed.ts",
    "db:export": "tsx --env-file-if-exists=../.env scripts/db-export.ts",
    "db:import": "tsx --env-file-if-exists=../.env scripts/db-import.ts",
    "seed:dist": "node --env-file-if-exists=../.env --enable-source-maps dist/scripts/seed.js",
    "db:export:dist": "node --env-file-if-exists=../.env --enable-source-maps dist/scripts/db-export.js",
    "db:import:dist": "node --env-file-if-exists=../.env --enable-source-maps dist/scripts/db-import.js"
  },
  "dependencies": {
    "@mern-blog/shared": "1.0.0",
    "@sendgrid/mail": "8.1.6",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "express": "5.3.0",
    "express-rate-limit": "8.7.1",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.11.2",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.3.0",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  }
}
