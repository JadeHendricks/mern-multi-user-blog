{
  "name": "@mern-blog/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API for the MERN multi-user blog",
  "main": "src/server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/server.js",
    "start": "node --env-file-if-exists=../.env src/server.js",
    "test:api": "vitest run --config vitest.config.mjs",
    "seed": "node --env-file-if-exists=../.env scripts/seed.js"
  },
  "dependencies": {
    "@sendgrid/mail": "7.2.1",
    "bcryptjs": "2.4.3",
    "cookie-parser": "1.4.5",
    "cors": "2.8.5",
    "express": "4.17.1",
    "express-mongo-sanitize": "2.0.0",
    "express-rate-limit": "5.1.3",
    "express-validator": "6.6.0",
    "helmet": "3.23.3",
    "hpp": "0.2.3",
    "jsonwebtoken": "8.5.1",
    "lodash": "4.17.15",
    "mongoose": "5.9.18",
    "morgan": "1.10.0",
    "multer": "1.4.1",
    "xss-clean": "0.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.1",
    "vitest": "5.0.5"
  }
}
