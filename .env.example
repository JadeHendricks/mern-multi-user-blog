# Copy to .env (npm run setup does this for you and fills JWT_SECRET). Never commit .env.
# Every key is optional except JWT_SECRET. Values below are placeholders or the defaults.

# API port and the browser origin the API trusts (used in email links and CORS).
PORT=5000
CLIENT_URL=http://localhost:3000

# Where data lives: json (files under DATA_DIR) or mongo (needs MONGO_URI).
DB_DRIVER=json
# DATA_DIR=server/data
# MONGO_URI=mongodb://127.0.0.1:27017/blog

# At least 32 characters. npm run setup replaces this placeholder with a random value.
JWT_SECRET=change-me
# Session length in days.
COOKIE_EXPIRES_IN=7

# file writes mail to DATA_DIR/outbox (default). sendgrid needs the three keys below.
MAIL_TRANSPORT=file
# SG_API_KEY=change-me
# EMAIL_FROM=noreply@example.com
# EMAIL_REPLY=noreply@example.com

# Failed-login style attempts allowed per 15 minutes on each auth endpoint.
AUTH_RATE_LIMIT_MAX=10
NODE_ENV=development
# Rolling JSON backups to keep.
BACKUP_KEEP=10
